graph LR

    %% ==========================================
    %% 1. HOSPITAL EDGE DEPLOYMENT PIPELINE
    %% ==========================================
    subgraph EdgeDevice ["■ Clinical AI Deployment Pipeline (Hospital Edge Device)"]
        direction LR

        A["<b>Chest Radiograph (CXR Input)</b><br/>BRAX Dataset (N = 41,208)<br/><i>X ∈ ℝ<sup>H×W</sup>, Prevalence π ≈ 4.4%</i>"]
        B["<b>Deep CNN Backbone</b><br/>DenseNet-121 / ResNet-50<br/>Weighted BCE Loss (w > 1)"]
        C["<b>Bayes-Optimal Shift</b><br/>z*(x) = logit(p) + log w<br/>Additive Intercept Bias: +3.07<br/><i>(Severe Over-Confidence)</i>"]

        A -->|Image X| B
        B -->|Logits z| C

        %% Conventional Branch
        D["<b>Temperature Scaling</b><br/>p̂<sub>temp</sub> = σ(z / T)<br/>Slope scaling only (T* ≈ 1.00)<br/><i>Fails: Intercept uncorrected</i>"]
        C -->|Tuning| D

        %% Mitigation Subgraph
        subgraph MitigationLoop ["■ Proposed Mitigation & Selective Decision Loop"]
            direction TB
            E["<b>Analytic Probability Offset (Ours)</b><br/>p̂<sub>analytic</sub> = σ(z - log w)<br/>• Exact algebraic neutralization<br/>• Zero validation tuning / Zero re-training<br/>• Preserves discriminative AUC ranking"]
            F["<b>Selective Prediction Deployment</b><br/>Risk-coverage thresholding: p̂<sub>cal</sub> ≷ τ<br/>Autonomous triage vs. Radiologist referral<br/><i>Guarantees safe risk coverage under drift</i>"]
            
            E -->|Calibrated p| F
        end

        C -->|Closed-Form| E
    end

    %% ==========================================
    %% 2. HELD-OUT EVALUATION LAYER (BRAX T3)
    %% ==========================================
    subgraph StratumEval ["■ Held-Out Evaluation (BRAX T3, 2017)"]
        direction TB

        G["<b>Held-Out Calibration Benchmark</b><br/>N = 2,436 radiographs (Year 2017)<br/><i>Brier Score (Lower is Better):</i><br/>━━━━━━━━━━━━━━━━━━━━━━<br/>• Raw Weighted: 0.1065<br/>• Temp Scaling: 0.1059<br/>• Analytic Offset: 0.0280 (<b>-74%</b>)<br/>• Unweighted (Ref): 0.0269<br/>━━━━━━━━━━━━━━━━━━━━━━<br/><b>Matches Unweighted Baseline</b>"]
        
        H["<b>Principal Clinical Finding</b><br/>1. Loss weighting creates illusory drift<br/>2. Subtracting log(w) recovers true calibration<br/>3. Selective prediction preserves safety"]

        G -->|Clinical Insights| H
    end

